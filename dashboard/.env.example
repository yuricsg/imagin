# Backend (Hono API) base URL used by the browser and the widget.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Optional: base URL used for server-side calls (NextAuth authorize,
# getDashboardData). Falls back to NEXT_PUBLIC_API_BASE_URL when unset.
# API_BASE_URL=http://localhost:4000

# Origin that serves the widget/iframe — becomes DEFAULT_EMBED.appBaseUrl,
# i.e. the domain written into the <script src> of newly created bots.
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# NextAuth (Auth.js) secret used to sign the session JWT. Required.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Required outside Vercel (Railway, Fly, a VPS): Auth.js only auto-trusts the
# forwarded host on Vercel. Without these it rejects sign-in with UntrustedHost
# and builds callback URLs from the container's internal address.
AUTH_TRUST_HOST=true
# AUTH_URL=https://dashboard-imagin.up.railway.app
